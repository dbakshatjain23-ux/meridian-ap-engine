# Test Environment Variables
APP_ENV=test
APP_HOST=0.0.0.0
APP_PORT=8000
WORKERS=1
LOG_LEVEL=debug

# Database (use in-memory SQLite for tests)
DATABASE_URL=sqlite+aiosqlite:///:memory:
DATABASE_POOL_SIZE=1
DATABASE_MAX_OVERFLOW=0

# Tenancy
DEFAULT_TENANT_SLUG=meridian

# Authentication
JWT_SECRET_KEY=test-secret-key-for-testing-only-min-64-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# LLM Provider (OpenAI)
OPENAI_API_KEY=sk-test-fake-key-for-testing
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_STRONG=gpt-4o
LLM_CACHE_TTL_SECONDS=3600
LLM_MAX_RETRIES=3

# Embeddings & Search
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_TOP_K=20
RRF_K=60

# Background Worker
WORKER_CONCURRENCY=1
JOB_POLL_INTERVAL_MS=1000
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_DELAY_SECONDS=30

# PII Redaction
PII_REDACTION_ENABLED=true
PII_PAN_REGEX='[A-Z]{5}[0-9]{4}[A-Z]{1}'
PII_BANK_REGEX='[0-9]{9,18}'
PII_AADHAAR_REGEX='[0-9]{4}\s?[0-9]{4}\s?[0-9]{4}'

# Feature Flags
ENABLE_LIVE_CONNECTORS=false
ENABLE_SOP_SYNC=false
ENABLE_MEETING_BOT=false
ENABLE_ERP_EMBED=false
ENABLE_TEAMS_APP=false
ENABLE_BROWSER_EXTENSION=false
SCHEMA_MODE=learned